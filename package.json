{
    "name": "tree-sitter-hazel",
    "version": "1.0.0",
    "description": "A tree-sitter parser for the Hazel language (in development by the UMich FP Lab)",
    "main": "bindings/node",
    "scripts": {
        "test": "tree-sitter test && tree-sitter parse 'test/hazel-code/*.hazel' --quiet --stat",
        "build": "tree-sitter generate",
        "build:wasm": "tree-sitter build-wasm"
    },
    "author": "green726",
    "license": "ISC",
    "dependencies": {
        "nan": "^2.17.0",
        "tree-sitter-cli": "^0.20.8"
    },
    "tree-sitter": [
        {
            "scope": "source.hazel",
            "file-types": [
                "hazel"
            ],
            "highlights": [
                "queries/highlights.scm"
            ]
        }
    ]
}
